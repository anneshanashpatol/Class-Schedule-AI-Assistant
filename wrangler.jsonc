{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "course-scheduler-assistant",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "services": [{ "binding": "MAIN_APP", "service": "course-scheduler" }],
  "d1_databases": [{ "binding": "AI_DB", "database_name": "course-scheduler-assistant-db", "database_id": "REPLACE_WITH_YOUR_AI_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
